# Amazon ML Worker - Environment Variables
# Copy to .env and fill in your values. NEVER commit .env!

# Hugging Face (optional - for model downloads)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Kaggle (optional - for Kaggle API access)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Alibaba Cloud PAI (optional - for heavy training)
# ALIBABA_ACCESS_KEY_ID=
# ALIBABA_ACCESS_KEY_SECRET=
# ALIBABA_REGION=

# Worker configuration overrides (optional)
# WORKER_ID=0
# TOTAL_WORKERS=1
# WORKER_TASK=etl
